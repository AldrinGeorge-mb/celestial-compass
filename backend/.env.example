# Copy this file to .env and fill in your actual API keys
PORT=5001

# NASA API Key — free at https://api.nasa.gov/
NASA_API_KEY=DEMO_KEY

# N2YO Satellite API — free at https://www.n2yo.com/api/
N2YO_API_KEY=your_n2yo_key_here

# Positionstack Geocoding API — free tier at https://positionstack.com/
POSITIONSTACK_API_KEY=your_positionstack_key_here

# OpenWeatherMap API — free tier at https://openweathermap.org/api
# Leave blank to use mock visibility scores
OPENWEATHER_API_KEY=your_openweather_key_here
